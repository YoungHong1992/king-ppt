node_modules/
*.pptx
.DS_Store
.debug/

# 运行时数据 / 日志（KING_PPT_HOME 默认写 ~/.king-ppt，项目内亦可能生成）
.king-ppt/
.king-ppt-*/
*.serve.log

# Local visual QA and benchmark artifacts
.vision/
exports/

# 内置生成的 provider 配置（含明文 API Key）。兜底：即便 KING_PPT_HOME 指向非 .king-ppt 前缀目录也不入库
**/config.json

# 参考项目（各自独立 git 仓库，仅供本地对照，不纳入本仓库）
dashi-ppt-skill/
ppt-master/

# 本地临时评审/探针产物（统一前缀，.tmp- 开头一律不入库）
.tmp-*

# 用户流程实测/逐页截图产物（本机评审用，不入库）
.user-flow-*
slides/

# Claude Code 本机个人配置（用户级全局 ignore 已挡一层，这里兜底其他机器）
.claude/settings.local.json
