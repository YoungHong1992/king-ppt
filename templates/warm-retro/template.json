{
  "schemaVersion": "1.1",
  "meta": {
    "id": "warm-retro",
    "name": "复古蓝米",
    "source": "preset",
    "licensing": { "redistributable": false, "commercialUse": "unknown" },
    "generalizationMode": "balanced"
  },
  "canvas": { "width": 13.33, "height": 7.5 },
  "palette": {
    "bg": "F7F1E5",
    "surface": "FBF7EE",
    "primary": "2B4C7E",
    "primaryDeep": "1F3A63",
    "accent": "E2703A",
    "secondary": "5B8A72",
    "divider": "D8CCB4",
    "warn": "C0392B",
    "text": "33302B",
    "textMuted": "6B6155",
    "textFaint": "99907F",
    "onDark": "F7F1E5",
    "onDarkMuted": "EFE6D2"
  },
  "typography": {
    "fonts": {
      "title": { "latin": "Georgia", "ea": "KaiTi" },
      "body": { "latin": "Segoe UI", "ea": "Microsoft YaHei" },
      "code": { "latin": "Consolas" }
    },
    "fontFallback": { "KaiTi": "Microsoft YaHei", "Georgia": "Georgia" },
    "scale": {
      "display": 54,
      "sectionNo": 112.5,
      "sectionTitle": 39,
      "pageTitle": 31.5,
      "conclusion": 21,
      "eyebrow": 16.5,
      "body": 15,
      "caption": 13.5,
      "footer": 12
    }
  },
  "decorations": {
    "ribbonCover": { "kind": "primitive", "shape": "parallelogram", "fill": "accent", "defaultSize": [3.0, 0.23], "role": "decoration", "behavior": "fixed" },
    "ribbonTitle": { "kind": "primitive", "shape": "parallelogram", "fill": "onDarkMuted", "defaultSize": [9.5, 0.71], "role": "decoration", "behavior": "fixed" },
    "iconDot": { "kind": "primitive", "shape": "ellipse", "fill": "accent", "defaultSize": [0.37, 0.37], "role": "decoration", "behavior": "fixed" },
    "sideEdge": { "kind": "primitive", "shape": "rect", "fill": "primaryDeep", "defaultSize": [0.25, 1.17], "role": "decoration", "behavior": "fixed" }
  },
  "families": {
    "cover": {
      "variants": {
        "default": {
          "background": {
            "color": "bg",
            "image": "assets/image1.jpg",
            "overlays": [
              { "color": "bg", "direction": "horizontal", "stops": [[0, 94], [0.4, 78], [0.7, 28], [1, 0]] },
              { "color": "bg", "direction": "vertical", "region": [0, 0.61, 1, 0.39], "stops": [[0, 0], [1, 55]] }
            ]
          },
          "decorations": [ { "use": "ribbonCover", "at": [0.75, 1.98] } ],
          "slots": {
            "eyebrow": { "rect": [0.75, 1.35, 10, 0.5], "size": "eyebrow", "color": "secondary", "bold": true, "letterSpacing": 4.5, "role": "content", "behavior": "generate" },
            "title": { "rect": [0.73, 2.35, 11.5, 2.1], "size": "display", "color": "primary", "bold": true, "font": "title", "role": "content", "behavior": "replace" },
            "subtitle": { "rect": [0.73, 4.6, 11.5, 0.7], "size": "conclusion", "color": "text", "role": "content", "behavior": "generate" },
            "author": { "rect": [0.73, 5.45, 10, 0.5], "size": "caption", "color": "textMuted", "role": "content", "behavior": "replace" }
          }
        }
      }
    },
    "section": {
      "variants": {
        "default": {
          "background": {
            "color": "bg",
            "images": ["assets/image2.jpg", "assets/image3.jpg", "assets/image4.jpg", "assets/image5.jpg", "assets/image6.jpg"],
            "overlay": { "color": "bg", "direction": "vertical", "stops": [[0, 0], [0.5, 30], [1, 92]] }
          },
          "slots": {
            "sectionNo": { "fromIndex": true, "rect": [0.94, 4.55, 2.8, 2.0], "size": "sectionNo", "color": "primary", "bold": true, "font": "title", "role": "chrome", "behavior": "fixed" },
            "eyebrow": { "rect": [4.1, 4.55, 8.5, 0.5], "size": "eyebrow", "color": "secondary", "bold": true, "letterSpacing": 4.5, "role": "content", "behavior": "generate" },
            "title": { "rect": [4.1, 5.1, 8.5, 0.95], "size": "sectionTitle", "color": "primary", "bold": true, "font": "title", "role": "content", "behavior": "replace" },
            "subtitle": { "rect": [4.1, 6.15, 8.5, 0.5], "size": "eyebrow", "color": "text", "role": "content", "behavior": "generate" }
          }
        }
      }
    },
    "content": {
      "variants": {
        "simple": {
          "background": { "color": "bg" },
          "chrome": ["titleBand", "summaryBar", "footer"]
        },
        "cards": {
          "background": { "color": "bg" },
          "chrome": ["titleBand", "summaryBar", "footer"]
        }
      }
    },
    "closing": {
      "variants": {
        "default": {
          "background": { "color": "primary" },
          "slots": {
            "quoteMark": { "text": "“", "rect": [0.9, 0.7, 2.2, 1.6], "size": 88, "color": "accent", "bold": true, "font": "title", "role": "decoration", "behavior": "fixed" },
            "quote": { "rect": [1.6, 2.4, 10.1, 2.2], "size": 30, "color": "onDark", "bold": true, "align": "center", "valign": "middle", "font": "title", "role": "content", "behavior": "generate" },
            "author": { "rect": [1.6, 5.0, 10.1, 0.6], "size": "eyebrow", "color": "onDarkMuted", "align": "right", "prefix": "—— ", "role": "content", "behavior": "generate" }
          }
        }
      }
    }
  },
  "components": {
    "titleBand": {
      "role": "chrome", "behavior": "fixed",
      "decorations": [
        { "use": "ribbonTitle", "at": [0.54, 0.40] },
        { "use": "iconDot", "at": [0.91, 0.57] }
      ],
      "slot": { "rect": [1.50, 0.50, 11, 0.85], "size": "pageTitle", "color": "primary", "bold": true }
    },
    "summaryBar": {
      "role": "chrome", "behavior": "fixed",
      "fill": "primary", "edge": { "fill": "primaryDeep", "width": 0.25 },
      "rect": [0.87, 5.2, 11.6, 1.17],
      "slots": {
        "conclusion": { "rect": [1.35, 5.32, 10.9, 0.6], "size": "conclusion", "color": "onDark", "bold": true },
        "note": { "rect": [1.35, 5.92, 10.9, 0.4], "size": "body", "color": "onDarkMuted" }
      }
    },
    "footer": {
      "role": "chrome", "behavior": "fixed",
      "y": 7.08, "marginX": 0.55, "size": "footer", "color": "textFaint"
    },
    "cardList": {
      "role": "content", "behavior": "repeat",
      "card": { "rect": [0.63, 1.5, 12.07, 3.4], "fill": "surface", "radius": 0.12, "border": { "color": "divider", "pt": 1 } },
      "rect": [1.0, 1.75, 11.3, 2.9], "bulletColor": "accent", "size": "body", "color": "text", "paraSpaceAfter": 10
    },
    "cardPair": {
      "role": "content", "behavior": "repeat",
      "card": { "fill": "surface", "radius": 0.12, "border": { "color": "divider", "pt": 1 }, "offsetY": 0.15 },
      "columns": { "xs": [0.63, 6.92], "w": 5.78, "tagY": 1.65, "tagH": 0.52, "bodyY": 2.45, "bodyH": 2.3, "bodyPadX": 0.2 },
      "tag": { "ribbon": true, "w": 2.88, "offsetX": 0.1, "fill": ["primary", "accent"], "color": "onDark", "size": "eyebrow", "bold": true, "align": "center" },
      "body": { "size": "caption", "color": "text", "bulletColor": "accent", "paraSpaceAfter": 8 }
    },
    "table": {
      "role": "content", "behavior": "generate",
      "rect": [0.63, 1.55, 12.07], "rowH": 0.5,
      "header": { "fill": "primary", "color": "onDark", "size": "caption", "bold": true, "align": "center" },
      "cell": { "color": "text", "size": "caption", "zebra": "surface", "plain": "bg", "border": { "color": "divider", "pt": 1 } }
    },
    "flowChain": {
      "role": "content", "behavior": "repeat",
      "maxItems": 5, "area": { "x": 0.63, "y": 1.75, "w": 12.07, "h": 3.1, "gap": 0.3 },
      "card": { "fill": "surface", "border": { "color": "divider", "pt": 1 }, "radius": 0.1 },
      "num": { "d": 0.62, "fill": "accent", "color": "onDark", "size": "conclusion", "bold": true, "offsetY": 0.3 },
      "title": { "size": "eyebrow", "color": "primary", "bold": true, "offsetY": 1.1, "h": 0.55 },
      "desc": { "size": "caption", "color": "textMuted", "offsetY": 1.7, "h": 1.25 }
    },
    "statCards": {
      "role": "content", "behavior": "repeat",
      "maxItems": 4, "area": { "x": 0.63, "y": 2.0, "w": 12.07, "h": 2.6, "gap": 0.35 },
      "card": { "fill": "surface", "border": { "color": "divider", "pt": 1 }, "radius": 0.1 },
      "value": { "size": "sectionTitle", "color": "accent", "bold": true, "offsetY": 0.35, "h": 1.1 },
      "label": { "size": "caption", "color": "textMuted", "offsetY": 1.6, "h": 0.6 }
    }
  },
  "typeMapping": {
    "title": { "candidates": ["cover.default"] },
    "section": { "candidates": ["section.default"] },
    "bullets": { "candidates": ["content.simple"] },
    "twoColumn": { "candidates": ["content.cards"] },
    "table": { "candidates": ["content.simple"] },
    "steps": { "candidates": ["content.cards"] },
    "quote": { "candidates": ["closing.default"] },
    "stats": { "candidates": ["content.cards"] }
  },
  "constraints": {
    "chars": { "pageTitle": 20, "bullet": 40, "cardTitle": 10, "conclusion": 50, "subtitle": 40, "tableCell": 20, "stepDesc": 30, "quote": 50 }
  },
  "capacity": {
    "cardList": { "preferredItems": 4, "maxItems": 6, "minFontSize": 12, "overflow": "compress" },
    "pageTitle": { "preferredLines": 1, "maxLines": 2, "minFontSize": 24, "overflow": "compress" },
    "summaryBar": { "preferredLines": 2, "maxLines": 3, "minFontSize": 15, "overflow": "truncate" }
  },
  "designGrammar": {
    "density": "low", "alignment": "left", "cornerStyle": "rounded",
    "cardStyle": "flat", "imageStyle": "fullBleed", "titlePattern": "ribbon",
    "numberStyle": "oversized", "whitespace": "generous"
  }
}
