{
  "schemaVersion": "1.1",
  "meta": {
    "id": "classic-blue",
    "name": "经典蓝",
    "source": "preset",
    "licensing": { "redistributable": true, "commercialUse": "allowed" },
    "generalizationMode": "conservative"
  },
  "canvas": { "width": 10, "height": 5.625 },
  "palette": {
    "bg": "FFFFFF",
    "surface": "F5F8FB",
    "primary": "1F4E79",
    "primaryDeep": "163A5C",
    "accent": "2E86C1",
    "secondary": "2E86C1",
    "divider": "D9E2EC",
    "warn": "C0392B",
    "text": "333333",
    "textMuted": "777777",
    "textFaint": "999999",
    "onDark": "FFFFFF",
    "onDarkMuted": "D6E4F0"
  },
  "typography": {
    "fonts": {
      "title": { "latin": "Microsoft YaHei", "ea": "Microsoft YaHei" },
      "body": { "latin": "Microsoft YaHei", "ea": "Microsoft YaHei" },
      "code": { "latin": "Consolas" }
    },
    "fontFallback": {},
    "scale": {
      "display": 36,
      "sectionNo": 72,
      "sectionTitle": 30,
      "pageTitle": 24,
      "conclusion": 18,
      "eyebrow": 15,
      "body": 16,
      "caption": 13,
      "footer": 12
    }
  },
  "decorations": {
    "titleBar": { "kind": "primitive", "shape": "rect", "fill": "accent", "defaultSize": [1.2, 0.05], "role": "decoration", "behavior": "fixed" },
    "sideBar": { "kind": "primitive", "shape": "rect", "fill": "accent", "defaultSize": [0.08, 2.4], "role": "decoration", "behavior": "fixed" },
    "coverBand": { "kind": "primitive", "shape": "rect", "fill": "accent", "defaultSize": [10, 1.42], "role": "decoration", "behavior": "fixed" }
  },
  "families": {
    "cover": {
      "variants": {
        "default": {
          "background": { "color": "primary" },
          "slots": {
            "title": { "rect": [0.8, 1.9, 8.4, 1.2], "size": "display", "color": "onDark", "bold": true, "align": "center", "role": "content", "behavior": "replace" },
            "subtitle": { "rect": [0.8, 3.2, 8.4, 0.8], "size": "conclusion", "color": "onDarkMuted", "align": "center", "role": "content", "behavior": "generate" }
          }
        },
        "band": {
          "background": { "color": "primaryDeep" },
          "decorations": [ { "use": "coverBand", "at": [0, 4.2] } ],
          "slots": {
            "title": { "rect": [0.8, 1.7, 8.4, 1.4], "size": "display", "color": "onDark", "bold": true, "role": "content", "behavior": "replace" },
            "subtitle": { "rect": [0.8, 3.1, 8.4, 0.7], "size": "conclusion", "color": "onDarkMuted", "role": "content", "behavior": "generate" },
            "author": { "rect": [0.8, 4.45, 8.4, 0.5], "size": "eyebrow", "color": "primaryDeep", "bold": true, "role": "content", "behavior": "replace" }
          }
        }
      }
    },
    "section": {
      "variants": {
        "default": {
          "background": { "color": "primary" },
          "slots": {
            "title": { "rect": [0.8, 2.2, 8.4, 1], "size": "sectionTitle", "color": "onDark", "bold": true, "align": "center", "role": "content", "behavior": "replace" },
            "subtitle": { "rect": [0.8, 3.2, 8.4, 0.6], "size": "body", "color": "onDarkMuted", "align": "center", "role": "content", "behavior": "generate" }
          }
        },
        "minimal": {
          "background": { "color": "surface" },
          "decorations": [ { "use": "sideBar", "at": [0.55, 2.0] } ],
          "slots": {
            "title": { "rect": [0.9, 2.05, 8.2, 1], "size": "sectionTitle", "color": "primary", "bold": true, "role": "content", "behavior": "replace" },
            "subtitle": { "rect": [0.9, 3.15, 8.2, 0.6], "size": "body", "color": "textMuted", "role": "content", "behavior": "generate" }
          }
        }
      }
    },
    "content": {
      "variants": {
        "simple": {
          "background": { "color": "bg" },
          "chrome": ["pageTitle"]
        },
        "cards": {
          "background": { "color": "bg" },
          "chrome": ["pageTitle"]
        },
        "tinted": {
          "background": { "color": "surface" },
          "chrome": ["pageTitle"]
        },
        "accentBar": {
          "background": { "color": "bg" },
          "chrome": ["pageTitle"],
          "decorations": [ { "use": "sideBar", "at": [0.5, 1.7] } ],
          "bodyRect": [0.9, 1.4, 8.5, 3.9]
        },
        "imageRight": {
          "background": { "color": "bg" },
          "chrome": ["pageTitle"],
          "wantsImage": true,
          "image": { "rect": [6.3, 1.5, 3.2, 3.6], "border": "divider" },
          "bodyRect": [0.6, 1.5, 5.4, 3.7]
        }
      }
    },
    "closing": {
      "variants": {
        "default": {
          "background": { "color": "primary" },
          "slots": {
            "quoteMark": { "rect": [0.8, 0.6, 2, 1.5], "size": 88, "color": "accent", "bold": true, "text": "“", "role": "decoration", "behavior": "fixed" },
            "quote": { "rect": [1.2, 2.0, 7.6, 2], "size": "pageTitle", "color": "onDark", "bold": true, "align": "center", "valign": "middle", "role": "content", "behavior": "generate" },
            "author": { "rect": [1.2, 4.2, 7.6, 0.6], "size": "body", "color": "onDarkMuted", "align": "right", "prefix": "—— ", "role": "content", "behavior": "generate" }
          }
        },
        "light": {
          "background": { "color": "surface" },
          "slots": {
            "quoteMark": { "rect": [0.8, 0.6, 2, 1.5], "size": 88, "color": "accent", "bold": true, "text": "“", "role": "decoration", "behavior": "fixed" },
            "quote": { "rect": [1.2, 2.0, 7.6, 2], "size": "pageTitle", "color": "text", "bold": true, "align": "center", "valign": "middle", "role": "content", "behavior": "generate" },
            "author": { "rect": [1.2, 4.2, 7.6, 0.6], "size": "body", "color": "textMuted", "align": "right", "prefix": "—— ", "role": "content", "behavior": "generate" }
          }
        }
      }
    }
  },
  "components": {
    "pageTitle": {
      "role": "chrome", "behavior": "fixed",
      "slot": { "rect": [0.5, 0.3, 9, 0.7], "size": "pageTitle", "color": "primary", "bold": true },
      "decorations": [ { "use": "titleBar", "at": [0.5, 1.0] } ]
    },
    "cardList": {
      "role": "content", "behavior": "repeat",
      "rect": [0.6, 1.3, 8.8, 4], "bulletColor": "accent", "size": "body", "color": "text", "paraSpaceAfter": 12
    },
    "cardPair": {
      "role": "content", "behavior": "repeat",
      "columns": { "xs": [0.5, 5.2], "w": 4.3, "tagY": 1.3, "tagH": 0.5, "bodyY": 2.0, "bodyH": 3.3, "bodyPadX": 0.1 },
      "tag": { "fill": "primary", "color": "onDark", "size": "eyebrow", "bold": true, "align": "center" },
      "body": { "size": "caption", "color": "text", "bulletColor": "accent", "paraSpaceAfter": 10 }
    },
    "table": {
      "role": "content", "behavior": "generate",
      "rect": [0.5, 1.3, 9], "rowH": 0.45,
      "header": { "fill": "primary", "color": "onDark", "size": "caption", "bold": true, "align": "center" },
      "cell": { "color": "text", "size": 12, "zebra": "surface", "border": { "color": "divider", "pt": 1 } }
    },
    "flowChain": {
      "role": "content", "behavior": "repeat",
      "maxItems": 5, "area": { "x": 0.5, "y": 1.6, "w": 9, "h": 3.2, "gap": 0.25 },
      "card": { "fill": "surface", "border": { "color": "divider", "pt": 1 }, "radius": 0.08 },
      "num": { "d": 0.6, "fill": "accent", "color": "onDark", "size": "conclusion", "bold": true, "offsetY": 0.3 },
      "title": { "size": "eyebrow", "color": "primary", "bold": true, "offsetY": 1.1, "h": 0.6 },
      "desc": { "size": 12, "color": "textMuted", "offsetY": 1.75, "h": 1.3 }
    },
    "statCards": {
      "role": "content", "behavior": "repeat",
      "maxItems": 4, "area": { "x": 0.5, "y": 1.8, "w": 9, "h": 2.4, "gap": 0.3 },
      "card": { "fill": "surface", "border": { "color": "divider", "pt": 1 }, "radius": 0.08 },
      "value": { "size": "display", "color": "accent", "bold": true, "offsetY": 0.3, "h": 1.1 },
      "label": { "size": "caption", "color": "textMuted", "offsetY": 1.5, "h": 0.7 }
    }
  },
  "typeMapping": {
    "title": { "candidates": ["cover.default", "cover.band"] },
    "section": { "candidates": ["section.default", "section.minimal"] },
    "bullets": { "candidates": ["content.simple", "content.accentBar", "content.imageRight"] },
    "twoColumn": { "candidates": ["content.cards", "content.tinted"] },
    "table": { "candidates": ["content.simple", "content.tinted"] },
    "steps": { "candidates": ["content.cards", "content.tinted"] },
    "quote": { "candidates": ["closing.default", "closing.light"] },
    "stats": { "candidates": ["content.cards", "content.tinted"] }
  },
  "constraints": {
    "chars": { "pageTitle": 20, "bullet": 40, "cardTitle": 10, "conclusion": 50, "subtitle": 40, "tableCell": 20, "stepDesc": 30, "quote": 50 }
  },
  "capacity": {
    "cardList": { "preferredItems": 4, "maxItems": 6, "minFontSize": 13, "overflow": "compress" },
    "pageTitle": { "preferredLines": 1, "maxLines": 2, "minFontSize": 18, "overflow": "compress" },
    "cardPair": { "preferredItems": 4, "maxItems": 6, "minFontSize": 11, "overflow": "compress" }
  },
  "designGrammar": {
    "density": "medium", "alignment": "left", "cornerStyle": "rounded",
    "cardStyle": "flat", "imageStyle": "none", "titlePattern": "bar",
    "numberStyle": "accent", "whitespace": "balanced"
  }
}
